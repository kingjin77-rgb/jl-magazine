@echo off
title Extract photos from PPTX
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='SilentlyContinue'; $arg='%~1'; if($arg -and (Test-Path -LiteralPath $arg)){ $f=Get-Item -LiteralPath $arg } else { $roots=@('D:\DDownloads',(Join-Path $env:USERPROFILE 'Downloads'),(Join-Path $env:USERPROFILE 'Desktop'),(Join-Path $env:USERPROFILE 'Documents'),$env:USERPROFILE,'D:\','C:\Users'); foreach($r in $roots){ if(Test-Path -LiteralPath $r){ $c=Get-ChildItem -LiteralPath $r -Recurse -Filter *.pptx -File | Where-Object {$_.Length -gt 5MB} | Sort-Object Length -Descending | Select-Object -First 1; if($c){ $f=$c; break } } } }; if(-not $f){ Write-Host ''; Write-Host '[X] No PPTX found.' -ForegroundColor Red; Write-Host '    Drag your PPTX file onto this .bat file and drop it.'; Write-Host ''; Read-Host 'Press Enter to close'; exit }; Write-Host ''; Write-Host ('[1] Found : ' + $f.Name) -ForegroundColor Cyan; Write-Host ('    Size  : ' + [math]::Round($f.Length/1MB,1) + ' MB'); $w=Join-Path $env:TEMP 'hua_extract'; if(Test-Path $w){ Remove-Item $w -Recurse -Force }; New-Item -ItemType Directory -Path $w | Out-Null; Copy-Item -LiteralPath $f.FullName -Destination (Join-Path $w 'a.zip') -Force; Write-Host '[2] Unpacking...' -ForegroundColor Cyan; Add-Type -AssemblyName System.IO.Compression.FileSystem; [System.IO.Compression.ZipFile]::ExtractToDirectory((Join-Path $w 'a.zip'),(Join-Path $w 'o')); $m=Join-Path $w 'o\ppt\media'; if(-not (Test-Path -LiteralPath $m)){ Write-Host '[X] No media folder inside.' -ForegroundColor Red; Read-Host 'Press Enter to close'; exit }; $d=Join-Path ([Environment]::GetFolderPath('Desktop')) 'PPT_PHOTOS'; if(Test-Path -LiteralPath $d){ Remove-Item -LiteralPath $d -Recurse -Force }; New-Item -ItemType Directory -Path $d | Out-Null; Get-ChildItem -LiteralPath $m -File | Where-Object { $_.Extension -match '(?i)^\.(png|jpe?g|gif|bmp|tif|tiff|emf|wmf)$' } | ForEach-Object { Copy-Item -LiteralPath $_.FullName -Destination $d -Force }; $n=(Get-ChildItem -LiteralPath $d -File).Count; Write-Host ''; Write-Host ('[3] DONE. ' + $n + ' images copied.') -ForegroundColor Green; Write-Host ('    Folder : ' + $d) -ForegroundColor Green; Write-Host ''; Write-Host '    Select all (Ctrl+A) and drag them into the GitHub upload page.'; Write-Host ''; Start-Process explorer.exe $d; Read-Host 'Press Enter to close'"
